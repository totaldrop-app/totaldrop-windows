<Page
    x:Class="TotalDrop.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PreviewKeyDown="OnPagePreviewKeyDown"
    AutomationProperties.Name="{x:Bind ViewModel.Strings.SettingsTitle, Mode=OneWay}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="640">

            <TextBlock
                Text="{x:Bind ViewModel.Strings.SettingsTitle, Mode=OneWay}"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="Wrap"
                IsTextScaleFactorEnabled="True"
                AutomationProperties.HeadingLevel="Level1" />

            <!-- Draft Translation Notice Banner (shown for 33 unreviewed locales) -->
            <Border
                Visibility="{x:Bind ViewModel.DraftBannerVisibility, Mode=OneWay}"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource TotalDropCardBackgroundBrush}"
                BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                BorderThickness="1">
                <TextBlock
                    Text="{x:Bind ViewModel.Strings.DraftTranslation, Mode=OneWay}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    IsTextScaleFactorEnabled="True"
                    AutomationProperties.LiveSetting="Polite" />
            </Border>

            <!-- Rendezvous Server Card -->
            <Border
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource TotalDropCardBackgroundBrush}"
                BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                BorderThickness="1"
                AutomationProperties.LandmarkType="Custom"
                AutomationProperties.LocalizedLandmarkType="{x:Bind ViewModel.Strings.SettingsServer, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.Strings.SettingsServer, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SettingsServer, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.HeadingLevel="Level2" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SettingsServerHelp, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />

                    <TextBox
                        x:Name="ServerUrlTextBox"
                        Text="{x:Bind ViewModel.ServerUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FlowDirection="LeftToRight"
                        Language="en-US"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        FontFamily="Cascadia Mono, Consolas"
                        KeyDown="OnServerUrlKeyDown"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.SettingsServer, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.Strings.SettingsServerHelp, Mode=OneWay}" />

                    <TextBlock
                        Text="{x:Bind ViewModel.ServerUrlError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ServerUrlErrorVisibility, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.LiveSetting="Assertive" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="SaveServerButton"
                            Grid.Column="0"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanSaveServer, Mode=OneWay}"
                            Click="OnSaveServerClick"
                            AutomationProperties.Name="{x:Bind ViewModel.Strings.SettingsSave, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.Strings.SettingsSave, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True" />
                        </Button>
                        <Button
                            x:Name="ResetServerButton"
                            Grid.Column="1"
                            IsEnabled="{x:Bind ViewModel.CanResetServer, Mode=OneWay}"
                            Click="OnResetServerClick"
                            AutomationProperties.Name="{x:Bind ViewModel.Strings.SettingsServerReset, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.Strings.SettingsServerReset, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Privacy Mode Card -->
            <Border
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource TotalDropCardBackgroundBrush}"
                BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                BorderThickness="1"
                AutomationProperties.LandmarkType="Custom"
                AutomationProperties.LocalizedLandmarkType="{x:Bind ViewModel.Strings.SettingsPrivacy, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.Strings.SettingsPrivacy, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SettingsPrivacy, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.HeadingLevel="Level2" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SettingsPrivacyBody, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />

                    <ToggleSwitch
                        x:Name="PrivacyModeToggle"
                        Header="{x:Bind ViewModel.Strings.PrivacyMode, Mode=OneWay}"
                        OffContent=""
                        OnContent=""
                        Toggled="OnPrivacyModeToggled"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.PrivacyMode, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.Strings.PrivacyModeHint, Mode=OneWay}" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.PrivacyModeHint, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />
                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource TotalDropCardBackgroundBrush}"
                BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                BorderThickness="1"
                AutomationProperties.LandmarkType="Custom"
                AutomationProperties.LocalizedLandmarkType="{x:Bind ViewModel.Strings.SettingsAbout, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.Strings.SettingsAbout, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SettingsAbout, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.HeadingLevel="Level2" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SettingsAboutBody, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SettingsWordsEnglish, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.VersionLabel, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />

                    <HyperlinkButton
                        x:Name="WebsiteLinkButton"
                        Content="totaldrop.app"
                        NavigateUri="https://totaldrop.app"
                        AutomationProperties.Name="totaldrop.app" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
