<Page
    x:Class="TotalDrop.WinUI.Views.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TotalDrop.WinUI.ViewModels"
    PreviewKeyDown="OnPagePreviewKeyDown"
    AutomationProperties.Name="{x:Bind ViewModel.PageTitle, Mode=OneWay}">

    <Page.Resources>
        <Storyboard x:Name="SendKoseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="SendKoseRotate"
                Storyboard.TargetProperty="Angle"
                Duration="0:0:3.2">
                <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="90">
                    <SplineDoubleKeyFrame.KeySpline>
                        <KeySpline ControlPoint1="0.65,0" ControlPoint2="0.35,1" />
                    </SplineDoubleKeyFrame.KeySpline>
                </SplineDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="90" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="180">
                    <SplineDoubleKeyFrame.KeySpline>
                        <KeySpline ControlPoint1="0.65,0" ControlPoint2="0.35,1" />
                    </SplineDoubleKeyFrame.KeySpline>
                </SplineDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="180" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="270">
                    <SplineDoubleKeyFrame.KeySpline>
                        <KeySpline ControlPoint1="0.65,0" ControlPoint2="0.35,1" />
                    </SplineDoubleKeyFrame.KeySpline>
                </SplineDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="270" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="360">
                    <SplineDoubleKeyFrame.KeySpline>
                        <KeySpline ControlPoint1="0.65,0" ControlPoint2="0.35,1" />
                    </SplineDoubleKeyFrame.KeySpline>
                </SplineDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="360" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="640">

            <TextBlock
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="Wrap"
                IsTextScaleFactorEnabled="True"
                AutomationProperties.HeadingLevel="Level1" />

            <!-- Idle Stage: Files Mode or Text Mode -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IdleVisibility, Mode=OneWay}">

                <!-- Mode Switch Row -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="FilesModeButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Click="OnSwitchToFilesModeClick"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.SendTitle, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.SendTitle, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                    </Button>
                    <Button
                        x:Name="TextModeButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Click="OnSwitchToTextModeClick"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.SendText, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.SendText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                    </Button>
                </Grid>

                <!-- Files Mode Selection -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.FilesModeVisibility, Mode=OneWay}">
                    <Border
                        x:Name="DropTargetCard"
                        AllowDrop="True"
                        DragOver="OnCardDragOver"
                        Drop="OnCardDrop"
                        Padding="24"
                        CornerRadius="8"
                        Background="{ThemeResource TotalDropCardBackgroundBrush}"
                        BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.SendDropHere, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.Strings.SendDropHint, Mode=OneWay}">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <SymbolIcon Symbol="OpenFile" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Strings.SendDropHere, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Strings.SendEmptyHint, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True" />
                            <Grid ColumnSpacing="8" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="AddFilesButton"
                                    Grid.Column="0"
                                    Click="OnAddFilesClick"
                                    AutomationProperties.Name="{x:Bind ViewModel.Strings.SendAddFiles, Mode=OneWay}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Strings.SendAddFiles, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        IsTextScaleFactorEnabled="True" />
                                </Button>
                                <Button
                                    x:Name="AddFolderButton"
                                    Grid.Column="1"
                                    Click="OnAddFolderClick"
                                    AutomationProperties.Name="{x:Bind ViewModel.Strings.PickTitle, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Folder" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Strings.PickTitle, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            IsTextScaleFactorEnabled="True" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Text="{x:Bind ViewModel.SelectionError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.SelectionErrorVisibility, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.LiveSetting="Assertive" />

                    <TextBlock
                        Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.LiveSetting="Polite" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedItems, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferItemModel">
                                <Border
                                    Padding="12,8"
                                    CornerRadius="6"
                                    Background="{ThemeResource TotalDropCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                                    BorderThickness="1">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind SafeDisplayName}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            IsTextScaleFactorEnabled="True"
                                            AutomationProperties.Name="{x:Bind SafeDisplayName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind FormattedSize, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            IsTextScaleFactorEnabled="True" />
                                        <Button
                                            Grid.Column="2"
                                            Tag="{x:Bind}"
                                            Click="OnRemoveItemClick"
                                            AutomationProperties.Name="{x:Bind SafeDisplayName}">
                                            <SymbolIcon Symbol="Cancel" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Text Mode Entry (MAX_TEXT = 1 MiB UTF-8 byte counter) -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.TextModeVisibility, Mode=OneWay}">
                    <TextBox
                        x:Name="SendTextBox"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="140"
                        MaxHeight="280"
                        PlaceholderText="{x:Bind ViewModel.Strings.SendTextHint, Mode=OneWay}"
                        Text="{x:Bind ViewModel.RawTextInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsReadOnly="{x:Bind ViewModel.IsBigTextActive, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.SendText, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.Strings.SendTextHint, Mode=OneWay}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind ViewModel.FormattedTextBytes, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True"
                            AutomationProperties.LiveSetting="Polite" />
                        <Button
                            x:Name="PasteSendTextButton"
                            Grid.Column="1"
                            Click="OnPasteSendTextClick"
                            AutomationProperties.Name="{x:Bind ViewModel.Strings.ReceivePaste, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.Strings.ReceivePaste, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True" />
                        </Button>
                        <Button
                            x:Name="ClearBigTextButton"
                            Grid.Column="2"
                            Visibility="{x:Bind ViewModel.ClearBigTextVisibility, Mode=OneWay}"
                            Click="OnClearTextClick"
                            AutomationProperties.Name="{x:Bind ViewModel.Strings.SendRemove, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.Strings.SendRemove, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True" />
                        </Button>
                    </Grid>

                    <TextBlock
                        Text="{x:Bind ViewModel.TextTooLongMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.TextTooLongVisibility, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.LiveSetting="Assertive" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SendTextShortened, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.TextShortenedNoticeVisibility, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />

                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.SendTextHidden, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.TextHiddenNoticeVisibility, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />

                    <TextBlock
                        Text="{x:Bind ViewModel.TextClipboardNotice, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.TextClipboardNoticeVisibility, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />
                </StackPanel>

                <!-- Stronger 3-word Code Option & Primary Create Code Action -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <ToggleSwitch
                            x:Name="StrongCodeToggle"
                            Header="{x:Bind ViewModel.Strings.SendStrongCode, Mode=OneWay}"
                            OffContent=""
                            OnContent=""
                            IsOn="{x:Bind ViewModel.UseStrongerThreeWordCode, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.Strings.SendStrongCode, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind ViewModel.Strings.SendStrongCodeHint, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.SendStrongCodeHint, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                    </StackPanel>

                    <Button
                        x:Name="CreateCodeButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanCreateCode, Mode=OneWay}"
                        Click="OnCreateCodeClick"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.SendCreateCode, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.SendCreateCode, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                    </Button>
                </Grid>

                <TextBlock
                    Text="{x:Bind ViewModel.Strings.SameNetworkNote, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    IsTextScaleFactorEnabled="True" />
            </StackPanel>

            <!-- Active Transfer Stage (Preparing / Waiting / Connected / Transferring) -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ActiveVisibility, Mode=OneWay}">
                <Viewbox
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Center"
                    FlowDirection="LeftToRight"
                    AutomationProperties.AccessibilityView="Raw">
                    <Canvas Width="112" Height="112">
                        <Path
                            Data="M55 15H97V57A42 42 0 1 1 55 15Z"
                            Fill="{ThemeResource TotalDropMarkBrush}">
                            <Path.RenderTransform>
                                <RotateTransform
                                    x:Name="SendKoseRotate"
                                    CenterX="55"
                                    CenterY="57"
                                    Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Viewbox>

                <TextBlock
                    Text="{x:Bind ViewModel.StatusCaption, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    IsTextScaleFactorEnabled="True"
                    AutomationProperties.LiveSetting="Polite" />

                <!-- Wormhole Transfer Code Card: always LeftToRight and spoken in English by Narrator -->
                <Border
                    Visibility="{x:Bind ViewModel.CodeCardVisibility, Mode=OneWay}"
                    Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource TotalDropCardBackgroundBrush}"
                    BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                    BorderThickness="1"
                    AutomationProperties.LandmarkType="Custom"
                    AutomationProperties.LocalizedLandmarkType="{x:Bind ViewModel.Strings.SendYourCode, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.Strings.SendYourCode, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.SendYourCode, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />

                        <TextBlock
                            x:Name="TransferCodeTextBlock"
                            Text="{x:Bind ViewModel.TransferCode, Mode=OneWay}"
                            FlowDirection="LeftToRight"
                            Language="en-US"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            FontFamily="Cascadia Mono, Consolas"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True"
                            AutomationProperties.LiveSetting="Assertive"
                            AutomationProperties.Name="{x:Bind ViewModel.TransferCode, Mode=OneWay}" />

                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.SendCodeHint, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="CopyCodeButton"
                                Grid.Column="0"
                                Click="OnCopyCodeClick"
                                AutomationProperties.Name="{x:Bind ViewModel.Strings.SendCopy, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Strings.SendCopy, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    IsTextScaleFactorEnabled="True" />
                            </Button>
                            <Button
                                x:Name="ShareCodeButton"
                                Grid.Column="1"
                                Click="OnShareCodeClick"
                                AutomationProperties.Name="{x:Bind ViewModel.Strings.SendShare, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Strings.SendShare, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    IsTextScaleFactorEnabled="True" />
                            </Button>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.Strings.SendCopied, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CopiedFeedbackVisibility, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True"
                                AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Four Verification Words Card (CPace + Noise XXpsk3 + ML-KEM-768) -->
                <Border
                    Visibility="{x:Bind ViewModel.VerificationVisibility, Mode=OneWay}"
                    Padding="16"
                    CornerRadius="8"
                    Background="{ThemeResource TotalDropCardBackgroundBrush}"
                    BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                    BorderThickness="1"
                    AutomationProperties.Name="{x:Bind ViewModel.Strings.VerificationTitle, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.VerificationTitle, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                        <TextBlock
                            Text="{x:Bind ViewModel.VerificationWords, Mode=OneWay}"
                            FlowDirection="LeftToRight"
                            Language="en-US"
                            FontFamily="Cascadia Mono, Consolas"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.VerificationHint, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                    </StackPanel>
                </Border>

                <!-- Regional Progress Bar (#483 floor rounding + Narrator RangeValuePattern sync) -->
                <StackPanel
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind ViewModel.Strings.SendSending, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.RegionalPercentText, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True"
                            AutomationProperties.LiveSetting="Polite" />
                    </Grid>

                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.WholePercent, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.SendSending, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.RegionalPercentText, Mode=OneWay}" />

                    <TextBlock
                        Text="{x:Bind ViewModel.FormattedProgressBytes, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />
                </StackPanel>

                <Button
                    x:Name="CancelSendButton"
                    HorizontalAlignment="Left"
                    Click="OnCancelSendClick"
                    AutomationProperties.Name="{x:Bind ViewModel.Strings.Cancel, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind ViewModel.Strings.Cancel, Mode=OneWay}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />
                </Button>
            </StackPanel>

            <!-- Done Stage (Resting Kose Mark + Done Checkmark) -->
            <Border
                Visibility="{x:Bind ViewModel.DoneVisibility, Mode=OneWay}"
                Padding="24"
                CornerRadius="8"
                Background="{ThemeResource TotalDropCardBackgroundBrush}"
                BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Viewbox
                        Width="48"
                        Height="48"
                        FlowDirection="LeftToRight"
                        AutomationProperties.AccessibilityView="Raw">
                        <Canvas Width="112" Height="112">
                            <Path
                                Data="M55 15H97V57A42 42 0 1 1 55 15Z"
                                Fill="{ThemeResource TotalDropMarkBrush}" />
                            <Path
                                Data="M37 58 L50 71 L74 45"
                                Stroke="{ThemeResource TotalDropMarkOnBrush}"
                                StrokeThickness="9"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock
                        Text="{x:Bind ViewModel.ResultTitle, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ResultBody, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True" />
                    <Button
                        x:Name="SendDoneResetButton"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="OnDoneResetClick"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.Done, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.Done, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Failed Stage with Expandable Details -->
            <Border
                Visibility="{x:Bind ViewModel.FailedVisibility, Mode=OneWay}"
                Padding="20"
                CornerRadius="8"
                Background="{ThemeResource TotalDropCardBackgroundBrush}"
                BorderBrush="{ThemeResource TotalDropCardStrokeBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorSummary, Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        IsTextScaleFactorEnabled="True"
                        AutomationProperties.LiveSetting="Assertive" />

                    <Button
                        x:Name="SendToggleDetailsButton"
                        Click="OnToggleErrorDetailsClick"
                        AutomationProperties.Name="{x:Bind ViewModel.Strings.MoreInfo, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.MoreInfo, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                    </Button>

                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ErrorDetailsVisibility, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorCauseDetail, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ErrorCauseDetailVisibility, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Strings.TechnicalDetail, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorTechnicalEnglish, Mode=OneWay}"
                            FlowDirection="LeftToRight"
                            Language="en-US"
                            FontFamily="Cascadia Mono, Consolas"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextScaleFactorEnabled="True" />
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="SendTryAgainButton"
                            Grid.Column="0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnTryAgainClick"
                            AutomationProperties.Name="{x:Bind ViewModel.Strings.TryAgain, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.Strings.TryAgain, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True" />
                        </Button>
                        <Button
                            x:Name="SendFailedDoneButton"
                            Grid.Column="1"
                            Click="OnDoneResetClick"
                            AutomationProperties.Name="{x:Bind ViewModel.Strings.Done, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.Strings.Done, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextScaleFactorEnabled="True" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
