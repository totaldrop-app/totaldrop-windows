<Window
    x:Class="TotalDrop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TotalDrop">

    <!-- Primary Fluent 2 Mica surface; MainWindow.xaml.cs falls back to DesktopAcrylicBackdrop or HighContrast solid surface -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootShellGrid"
        AutomationProperties.LandmarkType="Main"
        AutomationProperties.Name="TotalDrop">
        <Grid.Resources>
            <Storyboard x:Name="KoseRotationStoryboard" RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="BrandMarkRotate"
                    Storyboard.TargetProperty="Angle"
                    Duration="0:0:3.2">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="90">
                        <SplineDoubleKeyFrame.KeySpline>
                            <KeySpline ControlPoint1="0.65,0" ControlPoint2="0.35,1" />
                        </SplineDoubleKeyFrame.KeySpline>
                    </SplineDoubleKeyFrame>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="90" />
                    <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="180">
                        <SplineDoubleKeyFrame.KeySpline>
                            <KeySpline ControlPoint1="0.65,0" ControlPoint2="0.35,1" />
                        </SplineDoubleKeyFrame.KeySpline>
                    </SplineDoubleKeyFrame>
                    <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="180" />
                    <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="270">
                        <SplineDoubleKeyFrame.KeySpline>
                            <KeySpline ControlPoint1="0.65,0" ControlPoint2="0.35,1" />
                        </SplineDoubleKeyFrame.KeySpline>
                    </SplineDoubleKeyFrame>
                    <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="270" />
                    <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="360">
                        <SplineDoubleKeyFrame.KeySpline>
                            <KeySpline ControlPoint1="0.65,0" ControlPoint2="0.35,1" />
                        </SplineDoubleKeyFrame.KeySpline>
                    </SplineDoubleKeyFrame>
                    <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="360" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Windows 11 TitleBar integrated with DWM caption buttons -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,148,0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <!-- TotalDrop Kose Mark: explicitly LeftToRight so RTL layouts never mirror the upper-right corner (docs/tasarim.md) -->
                <Viewbox
                    Width="20"
                    Height="20"
                    FlowDirection="LeftToRight"
                    AutomationProperties.AccessibilityView="Raw">
                    <Canvas Width="112" Height="112">
                        <Path
                            x:Name="BrandMarkPath"
                            Data="M55 15H97V57A42 42 0 1 1 55 15Z"
                            Fill="{ThemeResource TotalDropMarkBrush}">
                            <Path.RenderTransform>
                                <RotateTransform
                                    x:Name="BrandMarkRotate"
                                    CenterX="55"
                                    CenterY="57"
                                    Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                        <Path
                            x:Name="BrandMarkDoneCheckPath"
                            Data="M37 58 L50 71 L74 45"
                            Stroke="{ThemeResource TotalDropMarkOnBrush}"
                            StrokeThickness="9"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Fill="Transparent"
                            Visibility="Collapsed" />
                    </Canvas>
                </Viewbox>

                <TextBlock
                    x:Name="WindowTitleText"
                    Text="TotalDrop"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    IsTextScaleFactorEnabled="True" />
            </StackPanel>
        </Grid>

        <!-- Top-level Fluent 2 Navigation between Send and Receive -->
        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="OnNavigationSelectionChanged"
            AutomationProperties.Name="{x:Bind Strings.DesktopGenericName, Mode=OneWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavSendItem"
                    Tag="send"
                    Content="{x:Bind SendTabTitle, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind SendTabTitle, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Upload" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavReceiveItem"
                    Tag="receive"
                    Content="{x:Bind ReceiveTabTitle, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ReceiveTabTitle, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="BusyNoticeInfoBar"
                    Grid.Row="0"
                    Margin="24,12,24,0"
                    Severity="Informational"
                    IsClosable="True"
                    IsOpen="{x:Bind IsBusyNoticeOpen, Mode=TwoWay}"
                    Title="TotalDrop"
                    Message="{x:Bind BusyNoticeMessage, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind BusyNoticeMessage, Mode=OneWay}"
                    AutomationProperties.LiveSetting="Assertive" />

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    Padding="24,16,24,24" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
