<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  IgnorableNamespaces="uap rescap desktop2">

  <!-- Native ARM64 MSIX slice for Windows 11 on ARM / Snapdragon X Copilot+ PCs (ADR 0016, #86).
       Identity Name and Publisher are replaced by Partner Center reservation at Store submission. -->
  <Identity
    Name="TotalDrop.TotalDrop"
    Publisher="CN=TotalDrop"
    Version="0.1.1.0"
    ProcessorArchitecture="arm64" />

  <Properties>
    <DisplayName>TotalDrop</DisplayName>
    <PublisherDisplayName>TotalDrop</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
    <!-- Windows App SDK 1.8 ARM64 Store-managed framework package (WindowsAppSDKSelfContained=false) -->
    <PackageDependency
      Name="Microsoft.WindowsAppRuntime.1.8"
      MinVersion="8000.994.2142.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <!-- All 35 supported TotalDrop languages (ADR 0008, ADR 0016) -->
  <Resources>
    <Resource Language="en" />
    <Resource Language="ar" />
    <Resource Language="bn" />
    <Resource Language="cs" />
    <Resource Language="da" />
    <Resource Language="de" />
    <Resource Language="el" />
    <Resource Language="es" />
    <Resource Language="fa" />
    <Resource Language="fi" />
    <Resource Language="fr" />
    <Resource Language="he" />
    <Resource Language="hi" />
    <Resource Language="hu" />
    <Resource Language="id" />
    <Resource Language="it" />
    <Resource Language="ja" />
    <Resource Language="ko" />
    <Resource Language="ms" />
    <Resource Language="nb" />
    <Resource Language="nl" />
    <Resource Language="pl" />
    <Resource Language="pt-BR" />
    <Resource Language="pt-PT" />
    <Resource Language="ro" />
    <Resource Language="ru" />
    <Resource Language="sv" />
    <Resource Language="sw" />
    <Resource Language="th" />
    <Resource Language="tr" />
    <Resource Language="uk" />
    <Resource Language="ur" />
    <Resource Language="vi" />
    <Resource Language="zh-Hans" />
    <Resource Language="zh-Hant" />
  </Resources>

  <Applications>
    <Application
      Id="TotalDropApp"
      Executable="totaldrop-winui.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="TotalDrop"
        Description="Send files straight to another device, end-to-end encrypted"
        BackgroundColor="#6D4AE0"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="TotalDrop"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- 1. Protocol URI Activation: totaldrop://r/<code> -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="totaldrop">
            <uap:DisplayName>TotalDrop Transfer Link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- 2. Windows Share Sheet Target -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Send encrypted files or text with TotalDrop">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>Text</uap:DataFormat>
            <uap:DataFormat>WebLink</uap:DataFormat>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>

        <!-- Phase 3 re-adds com:Extension (windows.comServer -> totaldrop_explorer_ext.dll,
             CLSID 8f6e3d72-4b9a-4e1c-9d3a-7c2f5a81e4b0) and desktop4:Extension
             (windows.fileExplorerContextMenus) once crates/totaldrop-explorer-ext is built,
             so Phase 1 makeappx.exe pack validates strictly without /nv. -->
      </Extensions>
    </Application>
  </Applications>

  <Extensions>
    <!-- Scoped UDP QUIC Firewall Rule installed/removed with MSIX package (ADR 0016) -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="totaldrop-winui.exe">
        <desktop2:Rule
          Direction="in"
          IPProtocol="UDP"
          Profile="private" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
